{
  "name": "@norminvoice/sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Official zero-dependency TypeScript/Node.js SDK for NormInvoice EU E-Invoicing (ZUGFeRD 2.3 / Factur-X 1.07 / XRechnung 3.0.2 / Peppol BIS 3.0)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
