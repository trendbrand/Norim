# =============================================================================
# NormInvoice — Production Environment Variables (EU Sovereign — Germany)
# =============================================================================

# App & Public URL
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NormInvoice

# Data store: single-node embedded SQLite (data/norminvoice.sqlite in the web_data volume).
# No DATABASE_URL is needed to run NormInvoice.
#
# PostgreSQL 16 + RLS is an OPTIONAL future scale path (Option B in docs/PRODUCTION_AUDIT.md).
# It is INERT unless DATABASE_URL is set to a real, non-default value. Leave this commented
# out for the SQLite MVP; setting it enables a best-effort write-through mirror (not the
# source of truth), so only enable it if you are migrating to Postgres deliberately.
# DATABASE_URL=postgresql://norminvoice:REPLACE_ME@localhost:5432/norminvoice

# Redis 7 (BullMQ + Rate Limits + VIES Cache)
REDIS_URL=redis://localhost:6379

# Internal Sandboxed Compliance Engine (Optional locally; required in Docker prod)
# When omitted, NormInvoice automatically runs the built-in deterministic EN 16931 + PDF/A-3b core.
# In Docker prod, point to http://einvoice-engine:8000 for Ghostscript PDF/A-3b + veraPDF + official KoSIT!
EINVOICE_ENGINE_URL=
EINVOICE_ENGINE_SHARED_SECRET=change_me_internal_engine_secret
KOSIT_VALIDATOR_URL=http://kosit-validator:8081

# Security & Persistent Multi-Tenant Storage
# Authentication & per-organization monthly quotas are ALWAYS strictly enforced.
# Set ENABLE_DEMO_LOGIN=false on live public servers to disable the 1-click demo workspace button.
ENABLE_DEMO_LOGIN=true
SQLITE_DATA_DIR=./data
# Comma-separated emails allowed to access /admin Super-Admin Control Plane
SUPERADMIN_EMAILS=founder@nordcloud-gmbh.de

# Separate platform STAFF realm (ADR-002) — admin is gated by its OWN session,
# not the customer session. Staff must sign in at /admin/login.
#   STAFF_AUTH_SECRET: >=32 chars, DIFFERENT from AUTH_SECRET (fail-fast in prod).
#   STAFF_ADMIN_EMAILS: allowlist of staff identities.
#   STAFF_ADMIN_PASSWORD: bootstrap plaintext (dev/single-node), >=8 chars; OR
#   STAFF_ADMIN_PASSWORD_HASH="saltHex:hashHex" (scrypt, preferred in prod).
STAFF_AUTH_SECRET=
STAFF_ADMIN_EMAILS=
STAFF_ADMIN_PASSWORD=
STAFF_ADMIN_PASSWORD_HASH=

# Envelope Encryption (32-byte hex key: openssl rand -hex 32 or pnpm env:init)
APP_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_SECRET=change_me_auth_secret_at_least_32_chars

# EU S3-Compatible Object Storage (Hetzner Object Storage / Scaleway EU — WORM GoBD Archive)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=norminvoice-gobd-archive
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_OBJECT_LOCK_ENABLED=true

# Stripe Integration (Bridge Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Paddle Merchant of Record Billing (Global + Pakistan friendly)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# EU Transactional Email (Resend EU / Postmark / Hetzner SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="NormInvoice E-Invoicing <invoices@norminvoice.eu>"

# EU VIES VAT Validation
VIES_TIMEOUT_MS=6000
VIES_CACHE_TTL_DAYS=7

# Peppol Access Point (certified PARTNER required for live network delivery).
# Leave unset: NormInvoice is not an accredited Access Point, so Peppol sends
# fail honestly ("no Access Point configured") rather than reporting fake success.
# Set all three with your provider's details (e.g. Storecove, Billit) to enable:
PEPPOL_AP_PROVIDER=
PEPPOL_AP_BASE_URL=
PEPPOL_AP_API_KEY=
