FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@12.21.0 --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/einvoice-core/package.json packages/einvoice-core/
COPY packages/db/package.json packages/db/
COPY services/worker/package.json services/worker/

RUN pnpm install --filter @norminvoice/worker...

COPY packages/einvoice-core packages/einvoice-core
COPY packages/db packages/db
COPY services/worker services/worker

RUN pnpm --filter @norminvoice/einvoice-core build && \
    pnpm --filter @norminvoice/db build && \
    pnpm --filter @norminvoice/worker build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nodejs && adduser -S worker -G nodejs

COPY --from=builder /app /app
USER worker
CMD ["node", "services/worker/dist/index.js"]
